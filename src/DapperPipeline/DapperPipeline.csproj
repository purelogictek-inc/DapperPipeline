<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>DapperPipeline</RootNamespace>
    <AssemblyName>DapperPipeline</AssemblyName>
    <!-- NuGet -->
    <PackageId>PureLogicTek.DapperPipeline</PackageId>
    <Description>SQL orchestration layer for Dapper — compile-time SQL injection prevention, fluent multi-command transactions, auto-parameterization, retry, and multi-result-set mapping. Database-agnostic core; add a dialect package (PureLogicTek.DapperPipeline.SqlServer, PureLogicTek.DapperPipeline.Sqlite, or PureLogicTek.DapperPipeline.PostgreSql) for your database.</Description>
    <PackageTags>dapper;sql;pipeline;cqrs;orm;transaction;sql-injection</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DapperPipeline.Tests" />
    <InternalsVisibleTo Include="DapperPipeline.Benchmarks" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageReference Include="Dapper" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
